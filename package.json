{
  "name": "live-favicon",
  "version": "1.0.0",
  "description": "Turn the current browser viewport into a live favicon.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/live-favicon.iife.js",
  "module": "./dist/live-favicon.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/live-favicon.esm.js",
      "default": "./dist/live-favicon.iife.js"
    },
    "./iife": "./dist/live-favicon.iife.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "rollup --config && node scripts/copy-types.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "modern-screenshot": "^4.6.6"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "rollup": "^4.31.0"
  }
}
